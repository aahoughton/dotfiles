{{/* Targets chezmoi deletes on apply: renamed or replaced files. Each entry can go
     once every machine has applied past the rename.

     The old server key goes only once its replacement exists, so an apply
     without 1Password (which skips server_ed25519) cannot leave a machine
     with neither. */}}
{{ if stat (joinPath .chezmoi.homeDir ".ssh/server_ed25519") -}}
.ssh/behemoth_ed25519
{{ end -}}
{{/* Replaced by bin/git-branch-status, which the fish function would shadow. */}}
.config/fish/functions/git-branch-status.fish
{{/* Moved to ~/.agents so every agent can read it. Same 1Password gate as the
     server key: the old copy goes only once the new one exists. */}}
{{ if stat (joinPath .chezmoi.homeDir ".agents/writing-voice.md") -}}
.claude/writing-voice.md
{{ end -}}
