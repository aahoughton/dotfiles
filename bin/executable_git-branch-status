#!/bin/bash
#
# git-branch-status -- show, for each local branch, where it stands relative to
# its upstream on origin: in sync / ahead / behind / diverged, or (if the
# upstream has been deleted) which PR integrated it.
#
# Why: `git branch -vv` reports per-branch sync state but doesn't tell you
# whether the work is already integrated into the default branch (origin/HEAD,
# called main below). This script identifies
# the integrating commit (via parent-of-merge for real merge commits, or
# `git patch-id` for squash / rebase merges) and surfaces the PR number
# with a link, regardless of whether the upstream branch still exists on
# origin (so it catches squash-merged branches whose source ref was kept).
#
# Sample output:
#     ISS-183                      832cdd8  merged in #313: https://github.com/org/repo/pull/313
#     ISS-956_libraries            5a229dc  merged in #303: https://github.com/org/repo/pull/303
#     ISS-72_renamer               a1b2c3d  in sync with origin/ISS-72_renamer; merged in #309: https://github.com/org/repo/pull/309
#     ISS-40_kafka                 7001540  in sync with origin/ISS-40_kafka
#     old-cleanup                  abe7360  upstream gone, branch predates scan window (try -a or larger -n)
#   * main                         3f86ee4  in sync with origin/main
#     saved-state                  f8e6272  no upstream
#
# Usage: git-branch-status [-n N | --depth N] [-a | --all] [--no-fetch]
#   -n N        Scan the last N commits on the default branch for squash-merge matches (default 500)
#   -a          Scan all of the default branch (use on repos with deep history)
#   --no-fetch  Skip the pre-fetch of the default branch (use when offline)

usage() {
    cat <<'EOF'
Usage: git-branch-status [-n N | --depth N] [-a | --all] [--no-fetch]
  -n N        Scan the last N commits on the default branch for squash-merge matches (default 500)
  -a          Scan all of the default branch (use on repos with deep history)
  --no-fetch  Skip the pre-fetch of the default branch (use when offline)
EOF
}

depth=500
no_fetch=0

while [[ $# -gt 0 ]]; do
    case "$1" in
        -n|--depth)
            if [[ $# -lt 2 ]]; then
                echo "git-branch-status: $1: option requires an argument" >&2
                exit 2
            fi
            depth="$2"; shift 2 ;;
        --depth=*)  depth="${1#--depth=}"; shift ;;
        -n?*)       depth="${1#-n}";       shift ;;
        -a|--all)   depth=0;    shift   ;;
        --no-fetch) no_fetch=1; shift   ;;
        -h|--help)  usage; exit 0 ;;
        *)          usage >&2; exit 2 ;;
    esac
done

# Checked before use: inside [[ ]] a non-number is evaluated as arithmetic, so
# "abc" would silently mean 0 (scan everything).
if ! [[ $depth =~ ^[0-9]+$ ]]; then
    echo "git-branch-status: depth must be a whole number, got: $depth" >&2
    exit 2
fi

if ! git rev-parse --git-dir >/dev/null 2>&1; then
    echo "git-branch-status: not a git repository" >&2
    exit 1
fi

# The default branch is whatever origin/HEAD points at. It is set by clone;
# a repo that got its remote later needs `git remote set-head origin --auto`.
# A repo with no origin at all compares against its local main or master.
if origin_head=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD); then
    main_branch=${origin_head#origin/}
elif ! git remote get-url origin >/dev/null 2>&1; then
    if git show-ref --verify --quiet refs/heads/main; then
        main_branch=main
    elif git show-ref --verify --quiet refs/heads/master; then
        main_branch=master
    else
        echo "git-branch-status: no origin remote, and no local main or master" >&2
        exit 1
    fi
else
    echo "git-branch-status: origin/HEAD is not set; run: git remote set-head origin --auto" >&2
    exit 1
fi
current=$(git rev-parse --abbrev-ref HEAD)

remote_url=$(git remote get-url origin 2>/dev/null)
repo_https=''
if [[ -n "$remote_url" ]]; then
    repo_https=$(printf '%s' "$remote_url" \
        | sed -E -e 's#^git@github\.com:#https://github.com/#' -e 's#\.git$##')
fi

# Refresh just origin/<main_branch> so squash-merge / ancestry checks reflect
# the current upstream state. Non-destructive: only writes the remote-tracking ref.
if [[ $no_fetch -eq 0 && -n "$remote_url" ]]; then
    git fetch --quiet origin "$main_branch" 2>/dev/null
fi

# Prefer origin/<main> for comparisons (kept current by the fetch above);
# fall back to local main when there's no remote-tracking ref.
main_ref=$main_branch
if git show-ref --verify --quiet "refs/remotes/origin/$main_branch"; then
    main_ref="origin/$main_branch"
fi

# Source of truth for which upstream branches still exist on the remote.
# Avoids relying on possibly-stale refs/remotes/origin/* (which only get
# pruned when the user runs `git fetch --prune` or `git remote prune`).
live_remotes=()
while IFS=$'\t' read -r _ ref; do
    [[ -z "$ref" ]] && continue
    live_remotes+=("origin/${ref#refs/heads/}")
done < <(git ls-remote --heads origin 2>/dev/null)

have_live_remotes=0
[[ ${#live_remotes[@]} -gt 0 ]] && have_live_remotes=1

contains() {
    local needle="$1"; shift
    local item
    for item in "$@"; do
        [[ "$item" == "$needle" ]] && return 0
    done
    return 1
}

# Lazily computed: "<patch-id> <commit-sha>" lines for the last N commits on main.
main_pids_loaded=0
main_pids=()

# Lazily computed: committer timestamp of the oldest commit in the scan window.
# Used to skip patch-id work for branches whose tip predates the window: a
# squash for those would lie outside our coverage anyway.
oldest_ts_loaded=0
oldest_ts=''

while IFS= read -r branch; do
    sha=$(git rev-parse --short "$branch")
    marker='  '
    [[ "$branch" == "$current" ]] && marker='* '

    upstream=$(git rev-parse --abbrev-ref --symbolic-full-name "${branch}@{upstream}" 2>/dev/null)

    is_gone=0
    if [[ -n "$upstream" ]]; then
        if [[ $have_live_remotes -eq 1 ]]; then
            contains "$upstream" "${live_remotes[@]}" || is_gone=1
        else
            git show-ref --verify --quiet "refs/remotes/$upstream" || is_gone=1
        fi
    fi

    # Did the branch tip predate the scan window? Used both to skip patch-id
    # work (a squash there is outside our coverage) and to differentiate
    # "no match" from "out of scope" in messaging.
    predates_window=0
    if [[ $depth -gt 0 ]]; then
        if [[ $oldest_ts_loaded -eq 0 ]]; then
            oldest_ts=$(git log "$main_ref" --format=%ct -n "$depth" 2>/dev/null | tail -n 1)
            oldest_ts_loaded=1
        fi
        if [[ -n "$oldest_ts" ]]; then
            branch_ts=$(git log -1 --format=%ct "$branch" 2>/dev/null)
            if [[ -n "$branch_ts" && "$branch_ts" -lt "$oldest_ts" ]]; then
                predates_window=1
            fi
        fi
    fi

    # Detect integration into main: parent-of-merge for real merges /
    # fast-forwards, patch-id match for squash / rebase merges. Runs for every
    # branch (gone or alive upstream) so the script catches PR-merged branches
    # whose source ref still exists on origin.
    # Note: a patch-id match means the branch's net diff equals a commit in
    # main's history; it doesn't certify the work survived later reverts or
    # refactors on main. A "yes, this PR shipped" hint, not a guarantee the
    # content is still in main HEAD.
    integration_note=''

    # Skip detection for main itself; comparing main to itself always passes
    # the ancestor check and yields a noisy "fast-forward".
    if [[ "$branch" == "$main_branch" ]]; then
        :
    elif git merge-base --is-ancestor "$branch" "$main_ref" 2>/dev/null; then
        branch_full=$(git rev-parse "$branch")
        merge_commit=''
        while IFS= read -r line; do
            mc=${line%% *}
            rest=${line#* }
            for p in $rest; do
                if [[ "$p" == "$branch_full" ]]; then
                    merge_commit=$mc
                    break 2
                fi
            done
        done < <(git log --merges --first-parent "${branch_full}..${main_ref}" --pretty='%H %P' 2>/dev/null)

        if [[ -n "$merge_commit" ]]; then
            subject=$(git log -1 --format=%s "$merge_commit")
            pr_num=''
            [[ "$subject" =~ \#([0-9]+) ]] && pr_num=${BASH_REMATCH[1]}
            short_sha=${merge_commit:0:7}
            if [[ -n "$pr_num" && -n "$repo_https" ]]; then
                integration_note="merged in #$pr_num: $repo_https/pull/$pr_num"
            elif [[ -n "$pr_num" ]]; then
                integration_note="merged in #$pr_num ($short_sha)"
            else
                integration_note="merged via $short_sha"
            fi
        else
            integration_note="merged into $main_branch (fast-forward)"
        fi
    elif [[ $predates_window -eq 0 ]]; then
        if [[ $main_pids_loaded -eq 0 ]]; then
            if [[ $depth -gt 0 ]]; then
                while IFS= read -r line; do
                    main_pids+=("$line")
                done < <(git log "$main_ref" -p -n "$depth" 2>/dev/null | git patch-id 2>/dev/null)
            else
                while IFS= read -r line; do
                    main_pids+=("$line")
                done < <(git log "$main_ref" -p 2>/dev/null | git patch-id 2>/dev/null)
            fi
            main_pids_loaded=1
        fi

        branch_pid=''
        read -r branch_pid _ < <(git diff "$main_ref...$branch" | git patch-id)

        matched_sha=''
        if [[ -n "$branch_pid" ]]; then
            for line in "${main_pids[@]}"; do
                read -r pid commit_sha <<< "$line"
                if [[ "$pid" == "$branch_pid" ]]; then
                    matched_sha=$commit_sha
                    break
                fi
            done
        fi

        if [[ -n "$matched_sha" ]]; then
            subject=$(git log -1 --format=%s "$matched_sha")
            pr_num=''
            [[ "$subject" =~ \#([0-9]+) ]] && pr_num=${BASH_REMATCH[1]}
            short_sha=${matched_sha:0:7}
            if [[ -n "$pr_num" && -n "$repo_https" ]]; then
                integration_note="merged in #$pr_num: $repo_https/pull/$pr_num"
            elif [[ -n "$pr_num" ]]; then
                integration_note="merged in #$pr_num ($short_sha)"
            else
                integration_note="merged as $short_sha"
            fi
        fi
    fi

    # Compose the line. When integration is found and the upstream is gone or
    # absent, the integration note stands alone (the gone-ness is implicit).
    # When integration is found alongside a live upstream, the upstream sync
    # info is still useful and gets joined with "; ".
    if [[ -z "$upstream" ]]; then
        if [[ -n "$integration_note" ]]; then
            printf '%s%-28s %s  %s\n' "$marker" "$branch" "$sha" "$integration_note"
        else
            printf '%s%-28s %s  no upstream\n' "$marker" "$branch" "$sha"
        fi
        continue
    fi

    if [[ $is_gone -eq 1 ]]; then
        if [[ -n "$integration_note" ]]; then
            printf '%s%-28s %s  %s\n' "$marker" "$branch" "$sha" "$integration_note"
        elif [[ $predates_window -eq 1 ]]; then
            printf '%s%-28s %s  upstream gone, branch predates scan window (try -a or larger -n)\n' "$marker" "$branch" "$sha"
        else
            scope_note="searched last $depth commits"
            [[ $depth -eq 0 ]] && scope_note="searched all of $main_branch"
            printf '%s%-28s %s  upstream gone, no patch-id match (%s)\n' "$marker" "$branch" "$sha" "$scope_note"
        fi
        continue
    fi

    read -r behind ahead < <(git rev-list --left-right --count "${upstream}...${branch}")
    if [[ "$ahead" == "0" && "$behind" == "0" ]]; then
        sync_line="in sync with $upstream"
    elif [[ "$behind" == "0" ]]; then
        sync_line="ahead $ahead of $upstream"
    elif [[ "$ahead" == "0" ]]; then
        sync_line="behind $behind of $upstream"
    else
        sync_line="diverged: $ahead ahead, $behind behind $upstream"
    fi

    if [[ -n "$integration_note" ]]; then
        printf '%s%-28s %s  %s; %s\n' "$marker" "$branch" "$sha" "$sync_line" "$integration_note"
    else
        printf '%s%-28s %s  %s\n' "$marker" "$branch" "$sha" "$sync_line"
    fi
done < <(git for-each-ref --format='%(refname:short)' refs/heads/)
