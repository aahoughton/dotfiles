#!/bin/bash
#
# gitsync — sync all git repos under a directory.
#
# For each repo: checks out default branch, pulls, prunes remote branches,
# deletes local branches that are both merged and gone from remote, and warns
# about case-insensitive branch name conflicts.
#
# Usage:
#   gitsync [-d depth] [-n] [directory]    (defaults to depth 1, current directory)
#     -n  dry run: list repos that would be synced

# ANSI Color Codes
RED='\033[0;31m'
NC='\033[0m'

DEPTH=1
DRY_RUN=false

while getopts "d:n" opt; do
    case $opt in
        d) DEPTH="$OPTARG" ;;
        n) DRY_RUN=true ;;
        *) echo "Usage: gitsync [-d depth] [-n] [directory]"; exit 1 ;;
    esac
done
shift $((OPTIND - 1))

TARGET_DIR="${1:-.}"

if [ ! -d "$TARGET_DIR" ]; then
    echo -e "${RED}Error: Directory $TARGET_DIR does not exist.${NC}"
    exit 1
fi

# Move to the target directory and hide the stack output
pushd "$TARGET_DIR" > /dev/null || exit

# Find git repos up to DEPTH levels deep. When a repo is found, prune so
# nested repos (submodules, monorepo children) are skipped.
REPOS=()
while IFS= read -r dir; do
    REPOS+=("$dir")
done < <(find . -maxdepth "$DEPTH" -type d -exec test -d "{}/.git" \; -print -prune | sort)

echo "Processing ${#REPOS[@]} directories..."

WARNINGS=()

for repo in "${REPOS[@]}"; do
    repo_name=${repo#./}

    if $DRY_RUN; then
        echo "$repo_name"
        continue
    fi

    # Enter the repo
    if pushd "$repo" > /dev/null; then
        echo "$repo_name"

        # Determine default branch locally (fast)
        DEFAULT_BRANCH=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^.*/@@')
        : "${DEFAULT_BRANCH:=main}"

        # 1. Checkout
        if ! git checkout "$DEFAULT_BRANCH" &>/dev/null; then
            WARNINGS+=("${RED}[!] $repo_name: Could not checkout $DEFAULT_BRANCH (dirty working tree?)${NC}")
        else
            # 2. Update (retry transient SSH/network resets with backoff)
            PULL_RC=1
            for attempt in 1 2 3; do
                PULL_OUTPUT=$(git pull --quiet 2>&1)
                PULL_RC=$?
                [ $PULL_RC -eq 0 ] && break
                sleep $((attempt * 2))
            done
            if [ $PULL_RC -ne 0 ]; then
                WARNINGS+=("${RED}[!] $repo_name: git pull failed after 3 attempts: $PULL_OUTPUT${NC}")
            elif [ -n "$PULL_OUTPUT" ]; then
                echo "  $PULL_OUTPUT"
            fi
            git remote prune origin --quiet &>/dev/null

            # 3. Safe Cleanup: Merged + Gone branches
            # Finds branches that are gone on remote AND merged into current HEAD
            while IFS= read -r b; do
                [ -n "$b" ] && git branch -d "$b" &>/dev/null
            done < <(git branch -vv | awk '/: gone]/ && $1 != "*" {print $1}' \
                       | while read -r br; do git branch --merged | grep -qx "  $br" && echo "$br"; done)
        fi

        # 4. Case-insensitive check
        DUPE_CHECK=$(git branch --format="%(refname:short)" | tr '[:upper:]' '[:lower:]' | sort | uniq -d)
        if [ -n "$DUPE_CHECK" ]; then
            for dupe in $DUPE_CHECK; do
                ACTUALS=$(git branch --format="%(refname:short)" | grep -i "^$dupe$" | xargs)
                WARNINGS+=("${RED}[!] $repo_name: Case-insensitive conflict: $ACTUALS${NC}")
            done
        fi

        # Exit the repo back to TARGET_DIR
        popd > /dev/null
    fi
done

# Final summary
if [ ${#WARNINGS[@]} -ne 0 ]; then
    echo -e "\nWarnings:"
    for warning in "${WARNINGS[@]}"; do
        echo -e "$warning"
    done
fi

# Return to where the user started
popd > /dev/null
