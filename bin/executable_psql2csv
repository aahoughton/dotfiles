#!/bin/bash
#
# psql2csv — run a query through psql and get clean CSV on stdout.
#
# Usage:
#   psql2csv [psql-options...] QUERY
#   psql2csv [psql-options...] < query.sql
#
# The query is the last positional argument, or stdin if piped.
# A last argument that looks like SQL (has whitespace or starts with
# SELECT/WITH/...) is always taken as the query, so an idle open stdin is
# never read.
# All other arguments are forwarded to psql (e.g. -h, -p, -U, -d).
#
# Examples:
#   psql2csv mydb "SELECT * FROM users"
#   psql2csv -h localhost -U admin mydb "SELECT * FROM users WHERE active"
#   psql2csv mydb < report.sql
#   echo "SELECT 1 AS n" | psql2csv mydb

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  psql2csv [psql-options...] QUERY
  psql2csv [psql-options...] < query.sql

Wraps a query in COPY (...) TO STDOUT to produce RFC 4180 CSV with headers.
All unrecognized options are forwarded directly to psql.

Options:
  -?, --help    Show this help
  --no-header   Omit the CSV header row
  --dry-run     Print the generated SQL instead of executing it
EOF
  exit 0
}

header=true
dry_run=false
psql_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --help|-\?) usage ;;
    --no-header) header=false; shift ;;
    --dry-run)   dry_run=true; shift ;;
    *)           psql_args+=("$1"); shift ;;
  esac
done

# True if the argument looks like SQL rather than a psql argument (e.g. a
# database name): it contains whitespace or starts with a query keyword.
looks_like_sql() {
  local re='^[[:space:]]*(select|with|values|table|\()'
  [[ "$1" =~ [[:space:]] ]] || [[ "$(tr '[:upper:]' '[:lower:]' <<< "$1")" =~ $re ]]
}

pop_last_arg() {
  query=${psql_args[${#psql_args[@]}-1]}
  unset 'psql_args[${#psql_args[@]}-1]'
}

# Query: a SQL-looking last argument wins; otherwise stdin if it isn't a
# terminal; otherwise the last argument. Checking the argument first matters
# when stdin is an open pipe that never gets data (e.g. under an agent or CI
# runner) -- reading it would block forever.
query=""
if [[ ${#psql_args[@]} -gt 0 ]] && looks_like_sql "${psql_args[${#psql_args[@]}-1]}"; then
  pop_last_arg
elif [[ ! -t 0 ]]; then
  query=$(cat)
fi
if [[ -z "$query" ]]; then
  if [[ ${#psql_args[@]} -gt 0 ]]; then
    pop_last_arg
  else
    echo "psql2csv: missing query (pass as last argument or via stdin)" >&2
    exit 1
  fi
fi

# Strip trailing semicolons — COPY (...) chokes on them.
query=$(printf '%s' "$query" | sed -E 's/[[:space:]]*;[[:space:]]*$//')

copy_opts="FORMAT csv"
[[ "$header" == true ]] && copy_opts="$copy_opts, HEADER"

sql="COPY ($query) TO STDOUT WITH ($copy_opts)"

if [[ "$dry_run" == true ]]; then
  printf '%s\n' "$sql"
else
  psql --no-psqlrc --quiet "${psql_args[@]}" <<< "$sql"
fi
