#!/bin/sh
# Claude Code rewrites ~/.claude/settings.json at runtime — toggling plugins,
# changing theme/model via /config — so chezmoi cannot own the whole file
# without fighting it for every edit.
#
# As a modify_ script this receives the current file on stdin and writes the
# new contents to stdout, so it enforces only the keys below and passes
# everything else through untouched. enabledPlugins in particular stays under
# Claude Code's control (and scripts/install-claude-plugins.sh), as does any
# key a future version adds.

set -eu

input=$(cat)

# Nothing to preserve on a fresh machine.
[ -n "$input" ] || input='{}'

# jq is installed by run_onchange_*-install-packages.sh, which sorts after
# .claude/ in the apply order — so the first apply on a new machine can reach
# this script before jq exists. Emit the managed keys and let a later apply
# fill in the rest rather than failing the whole run.
if ! command -v jq >/dev/null 2>&1; then
    if [ "$input" = '{}' ]; then
        cat <<'EOF'
{
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline-command.sh"
  },
  "tui": "fullscreen",
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true
}
EOF
    else
        printf '%s' "$input"
    fi
    exit 0
fi

# Malformed JSON is left exactly as found; clobbering it would lose whatever
# Claude Code was mid-write on, and the error is more useful than a silent reset.
if ! printf '%s' "$input" | jq empty >/dev/null 2>&1; then
    printf '%s' "$input"
    echo "chezmoi: ~/.claude/settings.json is not valid JSON; left unchanged" >&2
    exit 0
fi

# The review gate is deliberately NOT wired in here. It lives at
# ~/.claude/hooks/require-review-before-push.sh and is opted into one repo
# at a time, in that repo's .claude/settings.local.json; the script's own
# header explains why and how. Wiring it at the user level gated every
# repo on the machine, which is a real cost in the ones where a bad push
# is cheap.
#
# The strip below stays, and is the migration: a machine that applied the
# earlier version has the entry in this file already, and nothing else
# would ever take it back out. It also removes the older commit-stage
# gate. Entries left empty by the strip are dropped, and the containers
# are deleted if that empties them, so a settings.json that had no hooks
# of its own does not end up with a vestigial "hooks": {} .
#
# Everything else under .hooks is passed through untouched, so a hook
# added later through /hooks survives.
printf '%s' "$input" | jq '
      .statusLine = {"type": "command", "command": "~/.claude/statusline-command.sh"}
    | .tui = "fullscreen"
    | .skipAutoPermissionPrompt = true
    | .agentPushNotifEnabled = true
    | (if (.hooks.PreToolUse | type) == "array" then
         .hooks.PreToolUse = (
           .hooks.PreToolUse
           | map(.hooks |= map(select(.command != "~/.claude/hooks/require-review-before-commit.sh"
                                  and .command != "~/.claude/hooks/require-review-before-push.sh")))
           | map(select((.hooks | length) > 0))
         )
       else . end)
    | (if (.hooks.PreToolUse | type) == "array" and (.hooks.PreToolUse | length) == 0
       then del(.hooks.PreToolUse) else . end)
    | (if (.hooks | type) == "object" and (.hooks | length) == 0
       then del(.hooks) else . end)
'
