{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
# before_: the installers below write shell rc files and Claude Code's
# settings.json, which chezmoi also manages. Running first lets chezmoi's
# versions win, so a fresh machine is clean after one apply.
set -e

# Update package list
sudo apt-get update

# Install packages from packages.yaml
{{ range .packages.linux.packages -}}
echo "Installing {{ . }}..."
sudo apt-get install -y {{ . }} || echo "Failed to install {{ . }}, skipping..."
{{ end }}

# Install mise
if ! command -v mise &> /dev/null; then
    curl https://mise.run | sh
fi

# Install uv. The managed shell configs already put ~/.local/bin on PATH.
if ! command -v uv &> /dev/null; then
    curl -LsSf https://astral.sh/uv/install.sh | env UV_NO_MODIFY_PATH=1 sh
fi

# Install Claude Code
if ! command -v claude &> /dev/null; then
    curl -fsSL https://claude.ai/install.sh | bash
fi
{{ end -}}
