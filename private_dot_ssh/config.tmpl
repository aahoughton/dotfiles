{{ if eq .chezmoi.os "darwin" -}}
# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config
{{ end }}
# --- Machine-local hosts ---
# Anything not shared across machines (or not for a public repo) goes here.
# Included above every block below so it can override them; ssh takes the
# first value it sees for each parameter. Missing file is not an error.

Include ~/.ssh/config.local

# --- GitHub ---

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/github_ed25519

{{- if ne .chezmoi.hostname "behemoth" }}
# --- Behemoth (personal) ---
# One name from anywhere. On the home LAN, resolve via mDNS and skip the
# WireGuard tunnel: Tailscale does route over the LAN when both peers are on
# it, but userspace WireGuard plus the 1280 MTU still costs ~30-50% of bulk
# throughput, and the mDNS path keeps working when Tailscale is off.
# Off the home LAN, HostName defaults to the bare name, which MagicDNS
# resolves via the tailnet search domain.

Match host behemoth localnetwork 192.168.86.0/24
    HostName behemoth.local

Host behemoth
    User aah
    IdentityFile ~/.ssh/behemoth_ed25519
    HostKeyAlias behemoth
{{ end }}
# --- Defaults for all hosts ---
# Must come last: ssh_config uses first-match-wins per parameter, so this
# acts as a fallback that specific blocks above can still override.

Host *
    AddKeysToAgent yes
    ServerAliveInterval 15
    ServerAliveCountMax 4
    TCPKeepAlive yes

