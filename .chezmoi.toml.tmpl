{{- /* Every prompt passes an explicit default, which is what
       `chezmoi init --promptDefaults` writes. An empty machineType selects no
       machine-specific package set. */}}
{{- $machineType := promptStringOnce . "machineType" "Machine type (desktop/laptop)" "" -}}
{{- $machineName := promptStringOnce . "machineName" "Machine name (e.g. aah-mbp)" "" -}}
{{- $awsAccountId := promptStringOnce . "awsAccountId" "AWS account ID (blank to skip AWS config)" "" -}}
{{- $awsSsoStartUrl := promptStringOnce . "awsSsoStartUrl" "AWS SSO start URL (blank to skip)" "" -}}
{{- $onepasswordMode := promptStringOnce . "onepasswordMode" "1Password mode (account = desktop app, service = token)" "account" -}}

[data]
    machineType = {{ $machineType | quote }}
    machineName = {{ $machineName | quote }}
    awsAccountId = {{ $awsAccountId | quote }}
    awsSsoStartUrl = {{ $awsSsoStartUrl | quote }}
    # Stored here only so promptStringOnce reuses it; [onepassword] mode is
    # what chezmoi reads.
    onepasswordMode = {{ $onepasswordMode | quote }}

[onepassword]
{{- /* How you authenticate to 1Password is a separate question from what kind
       of machine this is: behemoth is a desktop with a GUI that is also driven
       headlessly over ssh. machineType additionally selects package sets
       (packages_<type>), so it must not be bent to mean "headless".

       account = 1Password desktop app, unlocked interactively.
       service = OP_SERVICE_ACCOUNT_TOKEN, the only option with no GUI.

       These are mutually exclusive: chezmoi errors in account mode if the
       token is set, and in service mode if it is not. A machine with a GUI
       should stay on account and simply not export the token -- applying it
       over ssh skips the vault-backed files rather than failing. */}}
    mode = {{ $onepasswordMode | quote }}
[hooks.read-source-state.pre]
    command = ".local/share/chezmoi/.install-password-manager.sh"
[git]
    autoAdd = false
    autoCommit = false
    autoPush = false
