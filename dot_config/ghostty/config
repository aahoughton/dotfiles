auto-update-channel = tip
bell-features = border
clipboard-paste-protection = true
copy-on-select = clipboard
# Lets the per-machine background tint (fish conf.d/ghostty_tint.fish) reach the
# titlebar as well as the terminal body. This is already the default, but the
# tint depends on it, so it should not be inherited silently.
macos-titlebar-style = transparent
scrollback-limit = 10_000_000
shell-integration-features = cursor,sudo,title,ssh-terminfo,ssh-env
theme = Monokai Pro Octagon
window-inherit-working-directory = false

keybind = super+arrow_left=previous_tab
keybind = super+arrow_right=next_tab
keybind = global:cmd+backquote=toggle_quick_terminal
keybind = shift+enter=text:\x1b\r
