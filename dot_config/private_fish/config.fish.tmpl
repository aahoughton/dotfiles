# PATH for every fish, interactive or not, so `ssh host <command>` finds the
# same tools a login does. Homebrew is found by absolute path: it is what puts
# itself on PATH, so asking PATH for it first only works when that already
# happened.
{{- if eq .chezmoi.os "darwin" }}
test -x /opt/homebrew/bin/brew && /opt/homebrew/bin/brew shellenv fish | source
{{- end }}
fish_add_path $HOME/go/bin
fish_add_path $HOME/bin
fish_add_path $HOME/.local/bin

if status is-interactive
    type -q mise && mise activate fish | source
    type -q direnv && direnv hook fish | source
    type -q jump && jump shell fish | source
    type -q atuin && atuin init fish | source

    # Editor aliases
    if type -q hx
        alias vi hx
        alias vim hx
        set -gx VISUAL hx
        set -gx EDITOR hx
    end

    alias gbs git-branch-status
else
    # Full activation hooks the prompt, which a non-interactive shell never
    # shows, so put the shims on PATH instead. On macOS Homebrew's mise
    # already activates every fish from vendor_conf.d; this matters where mise
    # is installed outside Homebrew (Linux).
    type -q mise && mise activate fish --shims | source
end

{{ if eq .chezmoi.os "darwin" }}
source ~/.orbstack/shell/init2.fish 2>/dev/null || :
{{ end }}
