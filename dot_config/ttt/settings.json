{
  "lsp": {
    "servers": {
      "go": {
        "command": ["gopls"]
      },
      "typescript": {
        "command": ["tsc", "--lsp", "--stdio"],
        "languages": {
          ".ts": "typescript",
          ".mts": "typescript",
          ".cts": "typescript",
          ".tsx": "typescriptreact",
          ".js": "javascript",
          ".mjs": "javascript",
          ".cjs": "javascript",
          ".jsx": "javascriptreact"
        }
      }
    }
  }
}
