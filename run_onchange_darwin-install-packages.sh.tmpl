{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash
# Without -e the script's status is the last command's, so a failed brew
# bundle was recorded as run and not retried until the package list changed.
set -e
{{- $typeKey := printf "packages_%s" .machineType -}}
{{- $typeData := index . $typeKey | default dict -}}
{{- $darwin := index $typeData "darwin" | default dict -}}
{{- $brews := concat .packages.darwin.brews (index $darwin "brews" | default list) -}}
{{- $casks := concat .packages.darwin.casks (index $darwin "casks" | default list) }}

# brew refuses to load formulae and casks from third-party taps until they are
# trusted. Listing one by its full tap path (owner/tap/name) is the decision to
# trust it, so trust exactly those entries, not their whole taps.
{{ range $brews -}}
{{ if eq (len (splitList "/" .)) 3 -}}
brew trust --formula {{ . | quote }}
{{ end -}}
{{ end -}}
{{ range $casks -}}
{{ if eq (len (splitList "/" .)) 3 -}}
brew trust --cask {{ . | quote }}
{{ end -}}
{{ end }}
brew bundle --file=/dev/stdin <<EOF
{{ range $brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range $casks -}}
cask {{ . | quote }}
{{ end -}}
EOF

# Install Claude Code
if ! command -v claude &> /dev/null; then
    curl -fsSL https://claude.ai/install.sh | bash
fi
{{ end -}}
