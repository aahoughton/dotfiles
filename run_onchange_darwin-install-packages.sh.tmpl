{{ if eq .chezmoi.os "darwin" -}}
#!/bin/bash

brew bundle --file=/dev/stdin <<EOF
{{ range .packages.darwin.brews -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.casks -}}
cask {{ . | quote }}
{{ end -}}
{{- $typeKey := printf "packages_%s" .machineType -}}
{{- $typeData := index . $typeKey | default dict -}}
{{- $darwin := index $typeData "darwin" | default dict -}}
{{- range index $darwin "brews" | default list -}}
brew {{ . | quote }}
{{ end -}}
{{- range index $darwin "casks" | default list -}}
cask {{ . | quote }}
{{ end -}}
EOF

# Install Claude Code
if ! command -v claude &> /dev/null; then
    curl -fsSL https://claude.ai/install.sh | bash
fi
{{ end -}}
